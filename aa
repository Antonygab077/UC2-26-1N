const prompt = require(`readline-sync`)

// ================== CLASSES ==================
let warrior = {
    ClassName: `Warrior`,
    health: 140,
    defense: 12,
    potions: 3,
    attack: function () {
        console.log("⚔️ Golpe pesado do Warrior!")
        let damage = Math.floor(Math.random() * 15) + 15
        return damage
    }
}

let ranger = {
    ClassName: `Ranger`,
    health: 120,
    defense: 10,
    potions: 3,
    attack: function () {
        console.log("🏹 Flecha certeira do Ranger!")
        let damage = Math.floor(Math.random() * 15) + 20
        return damage
    }
}

let wizard = {
    ClassName: `Wizard`,
    health: 110,
    defense: 8,
    potions: 3,
    attack: function () {
        console.log("✨ Magia poderosa do Wizard!")
        let damage = Math.floor(Math.random() * 15) + 30
        return damage
    }
}

// ================== ENEMIES ==================
let enemies = [
    { name: `Gorak`, health: 65, attack: () => Math.floor(Math.random() * 8) + 15 },
    { name: `Morthis`, health: 75, attack: () => Math.floor(Math.random() * 8) + 10 },
    { name: `Zargul`, health: 50, attack: () => Math.floor(Math.random() * 8) + 20 },
    { name: `Velkan`, health: 100, attack: () => Math.floor(Math.random() * 5) + 10 },
    { name: `Nyrax`, health: 45, attack: () => Math.floor(Math.random() * 8) + 25 }
]

// ================== VARIÁVEIS ==================
let character = null
let option

// ================== FUNÇÕES ==================
function createCharacter(name, yourClass) {
    return {
        name,
        class: yourClass,
        health: yourClass.health,
        defense: yourClass.defense,
        potions: yourClass.potions,
        defending: false
    }
}

function generateEnemy(enemies) {
    let i = Math.floor(Math.random() * enemies.length)
    return enemies.splice(i, 1)[0]
}

function attack(character, enemy) {
    let damage = character.class.attack()
    enemy.health -= damage
    return damage
}

function defend(character) {
    character.defending = true
}

function receiveDamage(character, damage) {
    if (character.defending) {
        damage = Math.round(damage / 2)
        character.defending = false
    }
    character.health -= damage
    return damage
}

function usePotion(character) {
    if (character.potions > 0) {
        let heal = 20
        character.health += heal
        character.potions--

        console.log(`🧪 Você recuperou ${heal} de vida`)
        console.log(`Poções restantes: ${character.potions}`)
    } else {
        console.log("🚫 Você não tem mais poções")
    }
}

function combatMenu(character, enemy) {
    let choice = Number(prompt.question(`
Escolha sua ação:
[1] Atacar
[2] Defender
[3] Usar poção
> `))

    if (choice == 1) {
        let damage = attack(character, enemy)
        console.log(`🔥 Você causou ${damage} de dano`)
    }
    else if (choice == 2) {
        defend(character)
        console.log("🛡️ Você se preparou para defender")
    }
    else if (choice == 3) {
        usePotion(character)
    }
    else {
        console.log("❗ Opção inválida")
    }

    prompt.question("Continuar...")
    console.clear()
}

function startCombat(character, enemy) {
    while (character.health > 0 && enemy.health > 0) {

        combatMenu(character, enemy)

        if (enemy.health <= 0) {
            console.log("🏆 Inimigo derrotado!")
            break
        }

        let damage = enemy.attack()
        let finalDamage = receiveDamage(character, damage)

        console.log(`💢 O inimigo causou ${finalDamage} de dano`)
        console.log(`❤️ Sua vida: ${character.health} | 👹 Vida do inimigo: ${enemy.health}`)
    }

    if (character.health <= 0) {
        console.log("💀 Você foi derrotado...")
    }

    prompt.question("Continuar...")
    console.clear()
}

// ================== MENU ==================
while (option !== 1 && option !== 0) {
    console.clear()
    console.log(`
======== AVENTURA RPG ========

[1] Novo jogo
[0] Sair

==============================
`)

    option = Number(prompt.question("Escolha: "))

    switch (option) {
        case 1:
            console.clear()
            let name = prompt.question("Digite seu nome: ")

            console.log(`
Escolha sua classe:

[1] Warrior (Resistente)
[2] Ranger (Equilibrado)
[3] Wizard (Alto dano)
`)

            let choice = Number(prompt.question("Classe: "))
            console.clear()

            switch (choice) {
                case 1:
                    character = createCharacter(name, warrior)
                    break
                case 2:
                    character = createCharacter(name, ranger)
                    break
                case 3:
                    character = createCharacter(name, wizard)
                    break
                default:
                    console.log("Classe inválida")
            }

            console.log(`
===== PERSONAGEM =====
Nome: ${character.name}
Classe: ${character.class.ClassName}
Vida: ${character.health}
Defesa: ${character.defense}
Poções: ${character.potions}
=====================
`)
            prompt.question("Começar aventura...")
            break

        case 0:
            process.exit()

        default:
            console.log("Opção inválida")
            prompt.question("Continuar...")
    }
}

// ================== LOOP DO JOGO ==================
while (enemies.length > 0 && character.health > 0) {

    let enemy = generateEnemy(enemies)

    console.log(`\n⚠️ Um ${enemy.name} apareceu!`)
    console.log(`Vida do inimigo: ${enemy.health}\n`)

    startCombat(character, enemy)

    if (character.health > 0) {
        console.log(`🎉 Você derrotou ${enemy.name}!`)
        prompt.question("Avançar...")
    }
}

if (character.health > 0) {
    console.log("👑 Você venceu todos os inimigos! Parabéns!")
}
